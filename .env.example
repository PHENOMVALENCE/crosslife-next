# CrossLife Next.js — copy to .env.local
APP_ENV=local
APP_DEBUG=true

# Site URL (optional; defaults to http://localhost:3000)
# SITE_URL=http://localhost:3000

# Database (same as PHP app)
DB_HOST=localhost
DB_NAME=crosslife
DB_USER=cross_user
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Session (generate a long random string)
SESSION_SECRET=change_me_to_a_long_random_string

# Mail / SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=CrossLife Mission Network
MAIL_ADMIN_ADDRESS=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Rate limits
MAIL_RATE_LIMIT_CONTACT=8
MAIL_RATE_LIMIT_WINDOW=3600
